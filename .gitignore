# Publish only the website. Anything else dropped in this folder (teaching packs,
# calendars, syllabus, the private instructor area) stays on this computer.
/*
!/.gitignore
!/README.md
!/index.html
!/chapter.html
!/sheet.html
!/assets/
!/chapters/
!/course/
!/tools/
# Pages written by tools/build.js
!/chapter-*/
!/topics/
!/404.html
!/sitemap.xml
# Search-engine ownership verification files
!/google*.html
!/BingSiteAuth.xml
